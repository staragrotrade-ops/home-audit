NEXT_PUBLIC_SITE_URL=https://homeaudit.com.au
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
QUOTE_SUBMISSION_ENABLED=false

# Optional. Set in the Production environment only (format G-XXXXXXXXXX).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Admin dashboard (/admin). It stays switched off (404) until both are set.
# Password: at least 10 characters. Secret: at least 24 random characters;
# changing it signs everyone out.
ADMIN_DASHBOARD_PASSWORD=
ADMIN_SESSION_SECRET=
# Optional key for rate-limit hashing (defaults to the Supabase secret key).
RATE_LIMIT_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

RESEND_API_KEY=
# e.g. Home Audit <bookings@homeaudit.com.au> (domain verified in Resend)
EMAIL_FROM=
EMAIL_REPLY_TO=info@homeaudit.com.au
ADMIN_NOTIFICATION_EMAIL=info@homeaudit.com.au

# Instant quotes: driving time from the base through Google Routes.
GOOGLE_MAPS_API_KEY=
TRAVEL_BASE_ADDRESS=Mount Eliza VIC 3930, Australia
# Google Business Profile "ask for reviews" link.
GOOGLE_REVIEW_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://homeaudit.com.au/api/admin/google/callback
GOOGLE_CALENDAR_ID=

INTERNAL_WORKER_SECRET=

# Cloudflare Turnstile bot check; the online quote form stays closed without it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Automatic agent lookup in the dashboard (Google AI Studio key, billing on).
GEMINI_API_KEY=
GEMINI_MODEL=

# Xero: paid invoices for jobs paid online. Use a separate Xero app for this
# site; redirect URI https://homeaudit.com.au/api/admin/xero/callback
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=
XERO_TENANT_ID=
XERO_SALES_ACCOUNT_CODE=
XERO_PAYMENT_ACCOUNT_CODE=
XERO_SALES_TAX_TYPE=
XERO_BRANDING_THEME_ID=
XERO_EMAIL_INVOICES=
# base64 of 32 random bytes; encrypts the stored Xero tokens.
INTEGRATION_ENCRYPTION_KEY=
