NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
QUOTE_SUBMISSION_ENABLED=false

# Optional. Set in the Production environment only (format G-XXXXXXXXXX).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Admin dashboard (/admin). It stays switched off (404) until both are set.
# Password: at least 10 characters. Secret: at least 24 random characters;
# changing it signs everyone out.
ADMIN_DASHBOARD_PASSWORD=
ADMIN_SESSION_SECRET=
# Optional key for rate-limit hashing (defaults to the Supabase secret key).
RATE_LIMIT_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

RESEND_API_KEY=
# e.g. Home Audit <bookings@homeaudit.com.au> (domain verified in Resend)
EMAIL_FROM=
EMAIL_REPLY_TO=info@homeaudit.com.au
ADMIN_NOTIFICATION_EMAIL=info@homeaudit.com.au

# Instant quotes: driving time from the base through Google Routes.
GOOGLE_MAPS_API_KEY=
TRAVEL_BASE_ADDRESS=Mount Eliza VIC 3930, Australia
# Google Business Profile "ask for reviews" link.
GOOGLE_REVIEW_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=

XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
